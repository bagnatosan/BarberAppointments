@model Barber.Models.User

@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card bg-black border border-secondary shadow-lg" style="width: 100%; max-width: 420px;">

        <div class="card-body px-4 py-5">
            <h2 class="text-center mb-1" style="font-family: 'Playfair Display', serif; font-style: italic; font-weight: 700;">
                Iniciar Sesión
            </h2>
            <p class="text-center text-secondary mb-4" style="font-size: 0.85rem; letter-spacing: 2px; text-transform: uppercase;">
                Caporale Barberia
            </p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger border-0 py-2 px-3" style="font-size: 0.875rem;">
                    @ViewBag.Error
                </div>
            }

            <form asp-controller="Account" asp-action="Login" method="post" id="form-login">
                <div class="mb-3">
                    <label asp-for="Email" class="form-label text-secondary" style="font-size: 0.8rem; letter-spacing: 1px; text-transform: uppercase;">
                        Correo electrónico
                    </label>
                    <input asp-for="Email"
                           type="email"
                           class="form-control bg-dark text-light border-secondary"
                           autocomplete="email" 
                           id="input-login"/>
                    <span asp-validation-for="Email" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>
                <div class="mb-3" id="password-hide" style="display: none">
                    <label asp-for="Password" class="form-label text-secondary" style="font-size: 0.8rem; letter-spacing: 1px; text-transform: uppercase;">
                        Contraseña
                    </label>
                    <input asp-for="Password"
                           type="password"
                           class="form-control bg-dark text-light border-secondary"
                           autocomplete="password" 
                           id="input-password"/>
                </div>
                <span asp-validation-for="Password" class="text-danger" style="font-size: 0.8rem;"></span>

                <div class="d-grid">
                    <button type="submit"
                            class="btn text-dark fw-bold"
                            style="background-color: #c9a96e; letter-spacing: 1px;">
                        Entrar
                    </button>
                </div>
            </form>

            <hr class="border-secondary my-4" />

            <p class="text-center text-secondary mb-0" style="font-size: 0.85rem;">
                ¿No tenés cuenta?
                <a asp-controller="Account" asp-action="Register"
                   class="text-decoration-none fw-semibold"
                   style="color: #c9a96e;">
                    Registrate
                </a>
            </p>
        </div>

    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
