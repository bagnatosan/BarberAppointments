<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Barber</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/Barber.styles.css" asp-append-version="true"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
</head>
<body class="bg-dark text-light">
<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-black border-bottom border-secondary py-2">
        <div class="container-fluid px-4">
            <!-- Brand -->
            <a class="navbar-brand m-0" asp-area="" asp-controller="Home" asp-action="Index">
                <h1 class="h3 mb-0 text-white" style="font-family: 'Playfair Display', serif; font-weight: 900; font-style: italic; letter-spacing: -1px; text-transform: uppercase;">
                    Caporale <span style="font-weight: 400; font-style: normal; letter-spacing: 4px; font-size: 0.6em; display: block; margin-top: -5px; color: #aaa;">Barberia</span>
                </h1>
            </a>

            <!-- Toggler for Mobile (ONLY visible on small screens) -->
            <button class="navbar-toggler border-0 d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Desktop Navigation (ONLY visible on large screens) -->
            <div class="collapse navbar-collapse d-none d-lg-flex" id="navbarDesktop">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link px-3" href="#">Servicios</a></li>
                    <li class="nav-item"><a class="nav-link px-3" asp-controller="Hairdresser" asp-action="Index">Peluqueros</a></li>
                    <li class="nav-item"><a class="nav-link px-3" href="#">Ubicación</a></li>
                    <li class="nav-item"><a class="nav-link px-3" href="#">Contacto</a></li>
                </ul>
            </div>

        </div>
    </nav>
</header>

<!-- Offcanvas Mobile Nav -->
<div class="offcanvas offcanvas-end offcanvas-nav" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
    <div class="offcanvas-header border-bottom border-secondary">
        <h5 class="offcanvas-title text-white" id="offcanvasNavbarLabel" style="font-family: 'Playfair Display', serif; font-weight: 900; font-style: italic; letter-spacing: -1px;">
            Caporale <span style="font-weight: 400; font-style: normal; letter-spacing: 4px; font-size: 0.6em; display: block; margin-top: -4px; color: #aaa;">Barberia</span>
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <ul class="navbar-nav flex-column gap-2 mt-2">
            <li class="nav-item"><a class="nav-link offcanvas-link" href="#">Servicios</a></li>
            <li class="nav-item"><a class="nav-link offcanvas-link" asp-controller="Hairdresser" asp-action="Index">Peluqueros</a></li>
            <li class="nav-item"><a class="nav-link offcanvas-link" href="#">Contacto</a></li>
            <li class="nav-item"><a class="nav-link offcanvas-link" href="#">Ubicación</a></li>
        </ul>
    </div>
</div>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top border-secondary footer text-light bg-black py-3 mt-auto">
    <div class="container text-center">
        <div class="d-flex align-items-center justify-content-center gap-3">
            <a href="https://www.instagram.com/caporalebarberia/" aria-label="Instagram">
                <img id="InstagramIcon" src="img/instagram.svg"/>
            </a>
            
            <p class="mb-0">&copy; @DateTime.Now.Year - Caporale Barberia - Elegancia y Tradición</p>
            
            <a href="https://wa.me/5491157549974" aria-label="WhatsApp" 
               rel="noopener noreferrer" target="_blank">
                <img src="~/img/whatsapp.svg" width="20" height="20" alt="WhatsApp" id="WhatsappIcon" />
            </a>
        </div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
