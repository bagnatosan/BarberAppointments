<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Barber</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
</head>
<body class="bg-dark text-light d-flex flex-column min-vh-100">
<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-black border-bottom border-secondary py-2">
        <div class="container-fluid px-4">
            <!-- Brand -->
            <a class="navbar-brand m-0" asp-area="" asp-controller="Home" asp-action="Index">
                <h1 class="h3 mb-0 text-white" style="font-family: 'Playfair Display', serif; font-weight: 900; font-style: italic; letter-spacing: -1px; text-transform: uppercase;">
                    Caporale <span style="font-weight: 400; font-style: normal; letter-spacing: 4px; font-size: 0.6em; display: block; margin-top: -5px; color: #aaa;">Barberia</span>
                </h1>
            </a>

            @if(User.Identity?.IsAuthenticated == true)            //? Operador de condicion nula
            {
                <div class="user-menu-container">
                    <p id="SessionIsActive" class="user-menu-toggle">@User.Identity.Name</p>
                    <div id="UserDropdown" class="user-dropdown-menu">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="dropdown-item-custom">Cerrar Sesión</button>
                        </form>
                    </div>
                </div>
            }
            
            else 
            {
                <a id="SessionIsUnactive" asp-controller="Account" asp-action="Login">Iniciar Sesion</a>
            }

        </div>
    </nav>
</header>

<div class="container-fluid p-0 flex-grow-1 d-flex flex-column">
    <main role="main" class="flex-grow-1 d-flex flex-column">
        @RenderBody()
    </main>
</div>

<footer class="border-top border-secondary text-light bg-black py-3 mt-auto">
    <div class="container text-center">
        <div class="d-flex align-items-center justify-content-center gap-3">
            <a href="https://www.instagram.com/caporalebarberia/" aria-label="Instagram">
                <img alt="Instagram" id="InstagramIcon" src="~/img/instagram.svg" width="20" height="20" />
            </a>
            
            <p class="mb-0">&copy; @DateTime.Now.Year - Caporale Barberia - Elegancia y Tradición</p>
            
            <a href="https://wa.me/5491157549974" aria-label="WhatsApp" 
               rel="noopener noreferrer" target="_blank">
                <img src="~/img/whatsapp.svg" width="20" height="20" alt="WhatsApp" id="WhatsappIcon" />
            </a>
        </div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
