@model Barber.Dto.AppointmentDto

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
}

<div class="container schedule-container">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8">
            
            <!-- Step 1: Select Barber -->
            <div class="mb-5 text-center">
                <h2 class="schedule-title">Elegí tu Barbero</h2>
                <input type="hidden" id="selected-barber-id" asp-for="SelectedHairdresserId" value="" />
                <div id="barber-buttons-list" class="d-flex justify-content-center gap-3 flex-wrap mt-3">
                    @foreach (var h in Model.Hairdressers)
                    {
                        <button type="button" class="btn btn-select-custom btn-barber" data-id="@h.Id">
                            @h.User?.FirstName
                        </button>
                    }
                </div>
            </div>

            <!-- Step 2: Select Service/Price -->
            <div id="step-service" class="mb-5 text-center" style="display: none;">
                <h2 class="schedule-title">Elegí el Servicio</h2>
                <input type="hidden" id="selected-haircut-id" name="SelectedHaircutId" value="" />
                <div id="service-buttons-list" class="d-flex justify-content-center gap-3 flex-wrap mt-3">
                    @foreach (var h in Model.Haircuts)
                    {
                        <button type="button" class="btn btn-select-custom btn-service" data-id="@h.Id">
                            @h.Name - $@h.Price
                        </button>
                    }
                </div>
            </div>

            <!-- Step 2 & 3: Calendar and Hours -->
            <div id="step-calendar" class="row justify-content-center" style="display: none;">
                
                
                <!-- Calendar -->
                <div class="col-md-7 mb-4 mb-md-0 d-flex flex-column align-items-center">
                    <h2 class="schedule-title">Seleccioná el Día</h2>
                    <div id="calendar-inline" style="display: none"></div>
                </div>
                
                <!-- Hours -->
                <div class="col-md-5 d-flex flex-column align-items-center">
                    <div id="hours-container" style="display: none; width: 100%;">
                        <h2 class="schedule-title">Seleccioná la Hora</h2>
                        <div id="slots-list">
                            <!-- Los horarios se cargarán aquí dinámicamente -->
                        </div>
                    </div>
                </div>
                
            </div>

            <!-- Step 4: Recurrence and Confirmation Options -->
            <div id="step-recurrence" class="mt-5 text-center" style="display: none;">
                <h2 class="schedule-title">Opciones de Reserva</h2>
                <div class="d-flex justify-content-center gap-3 flex-wrap mt-3">
                    <button type="button" id="btn-single-booking" class="btn btn-select-custom">
                        Reservar Turno Único
                    </button>
                    <button type="button" id="btn-toggle-recurrent" class="btn btn-select-custom">
                        Hacer Turno Fijo (Recurrente)
                    </button>
                </div>

                <!-- Sub-menu with recurrence interval options -->
                <div id="recurrence-options" class="mt-4" style="display: none; border-top: 1px solid rgba(212, 175, 55, 0.2); padding-top: 1.5rem;">
                    <p class="mb-3" style="color: #c0c0c0;">Elegí el intervalo de repetición:</p>
                    <div class="d-flex justify-content-center gap-4 flex-wrap">
                        <div class="d-flex flex-column align-items-center">
                            <button type="button" id="btn-recurrence-1" class="btn btn-select-custom btn-recurrence-opt" data-interval="1">
                                Cada 1 semana (Semanal)
                            </button>
                            <span id="weekly-status" class="mt-2" style="font-size: 0.85rem; color: #4caf50; font-weight: 600;">Disponible</span>
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <button type="button" id="btn-recurrence-2" class="btn btn-select-custom btn-recurrence-opt" data-interval="2">
                                Cada 2 semanas (Quincenal)
                            </button>
                            <span id="biweekly-status" class="mt-2" style="font-size: 0.85rem; color: #4caf50; font-weight: 600;">Disponible</span>
                        </div>
                    </div>
                    <div id="recurrence-clash-msg" class="text-danger mt-3" style="display: none; font-size: 0.9rem;">
                        * Este horario ya se encuentra ocupado en alguna de las fechas futuras necesarias.
                    </div>
                    <div class="mt-4">
                        <button type="button" id="btn-confirm-recurrent" class="btn btn-select-custom" style="background-color: #d4af37; color: #000; display: none;">
                            Confirmar Turno Recurrente
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/es.js"></script>
    <script src="~/js/appointment.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const btnSingle = document.getElementById('btn-single-booking');
            const btnRecurrent = document.getElementById('btn-toggle-recurrent');
            const btnWeekly = document.getElementById('btn-recurrence-1');
            const btnBiWeekly = document.getElementById('btn-recurrence-2');
            const btnConfirm = document.getElementById('btn-confirm-recurrent');

            if (btnSingle) {
                btnSingle.addEventListener('click', () => {
                    btnSingle.classList.add('selected');
                    if (btnRecurrent) btnRecurrent.classList.remove('selected');
                    if (btnWeekly) btnWeekly.classList.remove('selected');
                    if (btnBiWeekly) btnBiWeekly.classList.remove('selected');
                });
            }

            if (btnRecurrent) {
                btnRecurrent.addEventListener('click', () => {
                    btnRecurrent.classList.add('selected');
                    if (btnSingle) btnSingle.classList.remove('selected');
                });
            }

            if (btnWeekly) {
                btnWeekly.addEventListener('click', () => {
                    btnWeekly.classList.add('selected');
                    if (btnBiWeekly) btnBiWeekly.classList.remove('selected');
                });
            }

            if (btnBiWeekly) {
                btnBiWeekly.addEventListener('click', () => {
                    btnBiWeekly.classList.add('selected');
                    if (btnWeekly) btnWeekly.classList.remove('selected');
                });
            }

            const resetBookingOptions = () => {
                if (btnSingle) btnSingle.classList.remove('selected');
                if (btnRecurrent) btnRecurrent.classList.remove('selected');
                if (btnWeekly) btnWeekly.classList.remove('selected');
                if (btnBiWeekly) btnBiWeekly.classList.remove('selected');
                if (btnConfirm) btnConfirm.style.display = 'none';
            };

            // Reset when selecting/changing other steps
            document.querySelectorAll('.btn-barber').forEach(btn => {
                btn.addEventListener('click', resetBookingOptions);
            });

            document.querySelectorAll('.btn-service').forEach(btn => {
                btn.addEventListener('click', resetBookingOptions);
            });

            const calendarInline = document.getElementById('calendar-inline');
            if (calendarInline) {
                calendarInline.addEventListener('click', (e) => {
                    if (e.target.classList.contains('flatpickr-day')) {
                        resetBookingOptions();
                    }
                });
            }

            const slotsList = document.getElementById('slots-list');
            if (slotsList) {
                slotsList.addEventListener('click', (e) => {
                    if (e.target.classList.contains('btn-hour')) {
                        resetBookingOptions();
                    }
                });
            }
        });
    </script>
}
