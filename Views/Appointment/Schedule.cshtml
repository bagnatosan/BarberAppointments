@model Barber.ViewModels.AppointmentViewModel

@{
    ViewData["Title"] = "ScheduleAppoinment";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 mb-4">
            <label class="text-secondary small text-uppercase">1. Elegí tu Barbero</label>
            <select id="barber-select" class="form-select bg-black text-light border-secondary py-3" asp-for="SelectedHairdresserId">
                <option value="">Seleccionar...</option>
                @foreach (var h in Model.Hairdressers)
                {
                    <option value="@h.Id">@h.Name</option>
                }
            </select>
        </div>

        <div id="step-calendar" class="row justify-content-center" style="display: none;">
            <div class="col-md-5">
                <h5 class="text-white text-center mb-3">2. Seleccioná el Día</h5>
                <div id="calendar-inline"></div>
            </div>
            
            <div class="col-md-4">
                <div id="hours-container" style="display: none;">
                    <h5 class="text-white text-center mb-3">3. Seleccioná la Hora</h5>
                    <div id="slots-list" class="d-grid gap-2">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" type="text/css" href="https://npmcdn.com/flatpickr/dist/themes/dark.css">
    
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    
    <script src="~/js/site.js" asp-append-version="true"></script>
}
