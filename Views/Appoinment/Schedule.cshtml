@model Barber.ViewModels.AppoinmentViewModel

@{
    ViewData["Title"] = "ScheduleAppoinment";
}

<div class="container mt-5">
    <h2 class="text-center mb-5" style="font-family: 'Playfair Display', serif; color: #d4af37;">Reserva tu Turno</h2>
    
    <div class="row justify-content-center">
        <div class="col-md-5 mb-4">
            <div class="card bg-black border-secondary shadow">
                <div class="card-body">
                    <h5 class="text-white mb-3 text-center">1. Seleccioná el Día</h5>
                    <div id="calendar-inline"></div> </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div id="hours-container" class="card bg-black border-secondary shadow" style="display: none;">
                <div class="card-body">
                    <h5 class="text-white mb-3 text-center">2. Seleccioná la Hora</h5>
                    <div id="slots-list" class="d-grid gap-2">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" type="text/css" href="https://npmcdn.com/flatpickr/dist/themes/dark.css">
    
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    
    <script src="~/js/site.js" asp-append-version="true"></script>
}
