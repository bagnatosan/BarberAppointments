@using System.Security.Claims
@model IEnumerable<DateTime>;
@{
    ViewData["Title"] = "Home Page";
}


<!-- Hero -->
<section class="hero-section full-bleed">
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <img src="/img/caporale_logo.svg" alt="Caporale Barberia" class="hero-logo mb-5" />
        
        @if (Model.Any() && User.IsInRole("Customer"))
        {
            <div class="proximos-turnos-container">
                <div class="turnos-grid">
                    @foreach (var item in Model)
                    {
                        <div class="turno-card">
                            <h5 class="turno-card-title">Turno Confirmado</h5>
                            <p class="turno-card-text">
                                📅 <strong>Fecha:</strong> @item.ToString("dd/MM/yyyy") <br />
                                ⏰ <strong>Hora:</strong> @item.ToString("HH:mm") hs
                            </p>
                            <div style="text-align: center; margin-top: 10px;">
                                <span class="btn-cancelar-trigger" style="cursor: pointer; text-decoration: underline; color: #ffc107; font-size: 0.85em; display: block;">
                                    (toque para cancelar)
                                </span>
                            </div>
                            <div class="cancelar-confirmacion" style="display: none; text-align: center; margin-top: 15px; border-top: 1px solid rgba(212, 175, 55, 0.3); padding-top: 12px;">
                                <p style="margin-bottom: 10px; font-size: 0.9rem; color: #c0c0c0;">¿Estás seguro?</p>
                                <div style="display: flex; justify-content: center; gap: 15px;">
                                    <button class="btn-confirmar-si" data-date="@item.ToString("yyyy-MM-ddTHH:mm:ss")" style="background-color: #dc3545; color: white; border: none; padding: 6px 18px; border-radius: 20px; cursor: pointer; font-size: 0.85rem; font-weight: 600; text-transform: uppercase; transition: background-color 0.2s;">Sí</button>
                                    <button class="btn-confirmar-no" style="background-color: #6c757d; color: white; border: none; padding: 6px 18px; border-radius: 20px; cursor: pointer; font-size: 0.85rem; font-weight: 600; text-transform: uppercase; transition: background-color 0.2s;">No</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else if (User.IsInRole("admin"))
        {
            <div>
                <a class="btn-agendar" id="btnAdmin"
                   asp-controller="Admin" asp-action="">
                    Administrador
                </a>
            </div>
        }
        else
        {
            <div>
                <a class="btn-agendar" id="btnAgendar"
                   asp-controller="Appointment" asp-action="Schedule">
                    Agendar Turno
                </a>
            </div>
        }
    </div>
</section>

<!-- Peluqueros -->
<section class="barbers-section full-bleed">
    <div class="container">
        <h2 class="section-title">Nuestros Profesionales</h2>
        <div class="gold-divider"></div>
        <p class="section-body">
            En Caporale contamos con un equipo de barberos con años de experiencia en cortes clásicos y modernos.
            Cada profesional está dedicado a ofrecerte una experiencia única, combinando técnica, estilo y tradición barbera.
        </p>
        <a asp-controller="Hairdresser" asp-action="Index" class="btn-equipo">Conocé al equipo</a>
    </div>
</section>

<!-- Mapa -->
<section class="map-section full-bleed">
    <div class="map-wrapper">
        <iframe
            src="https://maps.google.com/maps?q=Saavedra+240,+Ramos+Mejia,+Buenos+Aires,+Argentina&output=embed&z=16"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Ubicación Caporale Barbería">
        </iframe>
    </div>
    <p class="map-address">Saavedra 240 — Ramos Mejía, Provincia de Buenos Aires</p>
</section>
