@using System.Security.Claims
@model IEnumerable<DateTime>;
@{
    ViewData["Title"] = "Home Page";
}


<!-- Hero -->
<section class="hero-section full-bleed">
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <img src="/img/caporale_logo.svg" alt="Caporale Barberia" class="hero-logo mb-5" />
        <div>
            <a class="btn-agendar" id="btnAgendar"
               asp-controller="Appointment" asp-action="Schedule">
                Agendar Turno
            </a>
        </div>
        <div>
            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    No tenés turnos reservados para los próximos días.
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var item in Model)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="card shadow-sm border-primary">
                                <div class="card-body">
                                    <h5 class="card-title text-primary">Turno Confirmado</h5>
                                    <p class="card-text">
                                        📅 <strong>Fecha:</strong> @item.ToString("dd/MM/yyyy") <br />
                                        ⏰ <strong>Hora:</strong> @item.ToString("HH:mm") hs
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            

        </div>
    </div>
</section>

<!-- Peluqueros -->
<section class="barbers-section full-bleed">
    <div class="container">
        <h2 class="section-title">Nuestros Profesionales</h2>
        <div class="gold-divider"></div>
        <p class="section-body">
            En Caporale contamos con un equipo de barberos con años de experiencia en cortes clásicos y modernos.
            Cada profesional está dedicado a ofrecerte una experiencia única, combinando técnica, estilo y tradición barbera.
        </p>
        <a asp-controller="Hairdresser" asp-action="Index" class="btn-equipo">Conocé al equipo</a>
    </div>
</section>

<!-- Mapa -->
<section class="map-section full-bleed">
    <div class="map-wrapper">
        <iframe
            src="https://maps.google.com/maps?q=Saavedra+240,+Ramos+Mejia,+Buenos+Aires,+Argentina&output=embed&z=16"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Ubicación Caporale Barbería">
        </iframe>
    </div>
    <p class="map-address">Saavedra 240 — Ramos Mejía, Provincia de Buenos Aires</p>
</section>


