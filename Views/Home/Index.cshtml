@using System.Security.Claims
@model Barber.Dto.RecurrenceAvailabilityDto
@{
    ViewData["Title"] = "Home Page";
}


<!-- Hero -->
<section class="hero-section full-bleed @(Model.Dates.Any() && User.IsInRole("Customer") ? "has-appointments" : "")">
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <img src="/img/caporale_logo.svg" alt="Caporale Barberia" class="hero-logo mb-5" />
        @if(!Model.Dates.Any() || !@Model.HasAppointmentRegular && User.IsInRole("Customer"))
        {
        <div>
            <a class="btn-agendar" id="btnAgendar"
               asp-controller="Appointment" asp-action="Schedule">
                Agendar Turno
            </a>
        </div>
        }
        
        @if(@Model.HasActiveRecurrence)
        {
            <div class="proximos-turnos-container">
                <div class="turnos-grid">
                    @foreach (var item in Model.Dates)
                    {
                        <div class="turno-card"
                             data-fecha="@(item.ToString("yyyy-MM-ddTHH:mm:ss"))"
                             data-userid="@User.FindFirst(ClaimTypes.NameIdentifier)?.Value"
                             data-recurrent ="@Model.HasActiveRecurrence">
                            <h5 class="turno-card-title">Turno Confirmado</h5>
                            <p class="turno-card-text">
                                📅 <strong>Fecha:</strong> @item.ToString("dd/MM/yyyy") <br />
                                ⏰ <strong>Hora:</strong> @item.ToString("HH:mm") hs
                            </p>
                            <div class="cancelar-trigger-container">
                                <span class="btn-cancelar-trigger">
                                    (pulse para cancelar)
                                </span>
                            </div>
                            <!-- Confirmación para turno común (No Recurrente) -->
                            <div class="cancelar-confirmacion normal-confirm">
                                <p>¿Estás seguro?</p>
                                <div class="cancelar-botones">
                                    <button class="btn-confirmar-si" data-date="@item.ToString("yyyy-MM-ddTHH:mm:ss")">Sí</button>
                                    <button class="btn-confirmar-no">No</button>
                                </div>
                            </div>

                            <!-- Confirmación para turno fijo (Recurrente) -->
                            <div class="cancelar-confirmacion recurrent-confirm">
                                <p class="mb-2">Este turno es fijo. ¿Qué deseas hacer?</p>
                                <div class="cancelar-botones flex-column gap-2">
                                    <button class="btn-confirmar-si btn-solo-este w-100" data-date="@item.ToString("yyyy-MM-ddTHH:mm:ss")">
                                        Cancelar solo este turno
                                    </button>
                                    <button class="btn-confirmar-serie btn-todos-fijos w-100" data-date="@item.ToString("yyyy-MM-ddTHH:mm:ss")">
                                        Cancelar todos los turnos fijos
                                    </button>
                                    <button class="btn-confirmar-no w-100 mt-1">Volver</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        
        else if (User.IsInRole("admin"))
        {
            <div>
                <a class="btn-agendar" id="btnAdmin"
                   asp-controller="Admin" asp-action="">
                    Administrador
                </a>
            </div>
        }
        
        
    </div>
</section>

<!-- Peluqueros -->
<section class="barbers-section full-bleed">
    <div class="container">
        <h2 class="section-title">Nuestros Profesionales</h2>
        <div class="gold-divider"></div>
        <p class="section-body">
            En Caporale contamos con un equipo de barberos con años de experiencia en cortes clásicos y modernos.
            Cada profesional está dedicado a ofrecerte una experiencia única, combinando técnica, estilo y tradición barbera.
        </p>
        <a asp-controller="Hairdresser" asp-action="Index" class="btn-equipo">Conocé al equipo</a>
    </div>
</section>

<!-- Mapa -->
<section class="map-section full-bleed">
    <div class="map-wrapper">
        <iframe
            src="https://maps.google.com/maps?q=Saavedra+240,+Ramos+Mejia,+Buenos+Aires,+Argentina&output=embed&z=16"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Ubicación Caporale Barbería">
        </iframe>
    </div>
    <p class="map-address">Saavedra 240 — Ramos Mejía, Provincia de Buenos Aires</p>
</section>

@section Scripts{
    <script src="js/index.js"></script>
}
