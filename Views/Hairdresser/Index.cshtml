@model IEnumerable<Barber.Models.Hairdresser>

@{
    ViewData["title"] = "Nuestros peluqueros";
}

<div class="container mt-5">
    <h1 class="display-4 text-center">Nuestros Profesionales</h1>
    <hr />

    <div class="table-responsive mt-4">
        <table class="table table-hover table-striped">
            <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre del Profesional</th>
                <th>Acciones</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary">Ver Agenda</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>